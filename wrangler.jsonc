// Cloudflare Workers config: the site is the static folder ./public, no build step.
// worker.js only handles video requests (to answer byte ranges for Safari);
// everything else is served straight from the static assets.
{
  "name": "ruslanthedirector",
  "compatibility_date": "2025-09-01",
  "main": "worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/assets/video/*"]
  }
}
